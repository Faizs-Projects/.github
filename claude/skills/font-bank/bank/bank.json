  "pairings": [
    {
      "id": "counter-poster",
      "name": "Counter poster",
      "half": "cool",
      "display": "darker-grotesque",
      "body": "outfit",
      "industries": [
        "restaurant",
        "taqueria",
        "takeout",
        "food-truck"
      ],
      "usedOn": "Taco Nazo, Colonia",
      "sampleDisplay": "Birria, with the consomm\u00e9.",
      "sampleBody": "Order at the counter. The phone number sits on the same screen as the dish.",
      "why": "Darker Grotesque is a tall Latin American grotesque, the kind of cheap-print letter a taqueria paints on the window. Outfit stays quiet so a menu can be read from a parking lot.",
      "scale": {
        "displaySize": "clamp(3.4rem, 8vw, 6.25rem)",
        "displayLineHeight": 0.88,
        "displayTracking": "-0.045em",
        "displayWeight": 800,
        "bodySize": "1.0625rem",
        "bodyLineHeight": 1.5,
        "bodyTracking": "0",
        "bodyWeight": 400
      }
    },
    {
      "id": "dining-room",
      "name": "Dining room",
      "half": "cool",
      "display": "fraunces",
      "body": "figtree",
      "industries": [
        "restaurant"
      ],
      "sampleDisplay": "Tonight's table.",
      "sampleBody": "The dish name can be soft. The hours and the phone stay plain.",
      "why": "Fraunces is a soft old-style serif for a sit-down room, not a counter. Figtree is a straight grotesque so the practical lines do not compete with the dish.",
      "scale": {
        "displaySize": "clamp(3rem, 6.5vw, 5.25rem)",
        "displayLineHeight": 0.96,
        "displayTracking": "-0.02em",
        "displayWeight": 560,
        "bodySize": "1.0625rem",
        "bodyLineHeight": 1.5,
        "bodyTracking": "0",
        "bodyWeight": 400
      }
    },
    {
      "id": "menu-editorial",
      "name": "Menu editorial",
      "half": "cool",
      "display": "newsreader",
      "body": "figtree",
      "industries": [
        "restaurant",
        "bar"
      ],
      "sampleDisplay": "The list for tonight.",
      "sampleBody": "Dishes, hours, and the phone, in that order, with room between them.",
      "why": "Newsreader is a text serif that still holds up as a headline. Figtree carries prices, hours, and the address without adding a second personality.",
      "scale": {
        "displaySize": "clamp(2.8rem, 6vw, 4.75rem)",
        "displayLineHeight": 1.02,
        "displayTracking": "-0.02em",
        "displayWeight": 520,
        "bodySize": "1.0625rem",
        "bodyLineHeight": 1.5,
        "bodyTracking": "0",
        "bodyWeight": 400
      }
    },
    {
      "id": "cafe-window",
      "name": "Cafe window",
      "half": "cool",
      "display": "fraunces",
      "body": "nunito-sans",
      "industries": [
        "cafe",
        "bakery"
      ],
      "sampleDisplay": "Morning, on the glass.",
      "sampleBody": "Coffee, a pastry, and a seat if there is one.",
      "why": "Fraunces at a lighter weight feels painted on a cafe window. Nunito Sans is round enough for a short menu and still readable at arm's length.",
      "scale": {
        "displaySize": "clamp(3rem, 7vw, 5.5rem)",
        "displayLineHeight": 0.95,
        "displayTracking": "-0.02em",
        "displayWeight": 500,
        "bodySize": "1.0625rem",
        "bodyLineHeight": 1.5,
        "bodyTracking": "0",
        "bodyWeight": 400
      }
    },
    {
      "id": "night-sign",
      "name": "Night sign",
      "half": "cool",
      "display": "syne",
      "body": "outfit",
      "industries": [
        "bar"
      ],
      "sampleDisplay": "Open late.",
      "sampleBody": "The address and the last hour, readable from the sidewalk.",
      "why": "Syne is wide and a little strange, closer to a painted bar sign than to a logo template. Outfit does the hours so the sign does not have to.",
      "scale": {
        "displaySize": "clamp(3.2rem, 8vw, 6rem)",
        "displayLineHeight": 0.9,
        "displayTracking": "-0.04em",
        "displayWeight": 750,
        "bodySize": "1.0625rem",
        "bodyLineHeight": 1.5,
        "bodyTracking": "0",
        "bodyWeight": 400
      }
    },
    {
      "id": "practice",
      "name": "Practice",
      "half": "cool",
      "display": "source-serif-4",
      "body": "source-sans-3",
      "industries": [
        "dentist",
        "lawyer",
        "trade"
      ],
      "sampleDisplay": "The office.",
      "sampleBody": "The phone, the hours, and how to book. Nothing else in the way.",
      "why": "Source Serif 4 for the name, Source Sans 3 for the facts. It reads as a practice, not a costume and not a startup landing page.",
      "scale": {
        "displaySize": "clamp(2.6rem, 5vw, 4.25rem)",
        "displayLineHeight": 1.05,
        "displayTracking": "-0.015em",
        "displayWeight": 560,
        "bodySize": "1.0625rem",
        "bodyLineHeight": 1.5,
        "bodyTracking": "0",
        "bodyWeight": 400
      }
    }
  ],
  "avoid": [
    {
      "families": [
        "Inter"
      ],
      "why": "The body face of a generic template. A page set in Inter looks unfinished before the layout is even judged."
    },
    {
      "families": [
        "Poppins",
        "Playfair Display"
      ],
      "why": "The default pairing from an AI layout. A geometric sans plus a fashionable serif, with no tie to the business."
    },
    {
      "families": [
        "Bebas Neue",
        "Anton",
        "Lilita One"
      ],
      "why": "Compressed poster faces used as a shortcut for loud. Every restaurant that uses them looks like the same poster."
    },
    {
      "families": [
        "Montserrat"
      ],
      "why": "Used for the headline and the menu, so nothing has a role."
    },
    {
      "families": [
        "Comic-style script"
      ],
      "why": "A script face named like a joke, including anything in the Ol\u00e9 family, reads as a costume instead of the shop."
    }
  ]
}
