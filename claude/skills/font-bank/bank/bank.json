  "avoid": [
    {
      "families": [
        "Inter"
      ],
      "why": "The body face of a generic template. A page set in Inter looks unfinished before the layout is even judged."
    },
    {
      "families": [
        "Poppins",
        "Playfair Display"
      ],
      "why": "The default pairing from an AI layout. A geometric sans plus a fashionable serif, with no tie to the business."
    },
    {
      "families": [
        "Bebas Neue",
        "Anton",
        "Lilita One"
      ],
      "why": "Compressed poster faces used as a shortcut for loud. Every restaurant that uses them looks like the same poster."
    },
    {
      "families": [
        "Montserrat"
      ],
      "why": "Used for the headline and the menu, so nothing has a role."
    },
    {
      "families": [
        "Comic-style script"
      ],
      "why": "A script face named like a joke, including anything in the Ol\u00e9 family, reads as a costume instead of the shop."
    }
  ]
